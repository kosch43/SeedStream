# Build-from-source image for self-hosting SeedStream.
#
# Builds the React UI and the Go binary from this repository, with no prebuilt
# artifacts or external registry required. Use it via docker-compose.yml:
#   docker compose up -d --build
#
# (The plain `Dockerfile` is used by the release CI, which packages prebuilt
# multi-arch binaries — not what you want for a local server build.)

# --- Stage 1: build the frontend ---
FROM node:22-alpine AS frontend
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# --- Stage 2: build the Go binary ---
FROM golang:1.25-alpine AS backend
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
WORKDIR /src
# Review/test containers made from this stage are temporary and must not be
# treated as deployable images by WUD.
LABEL wud.watch="false"
RUN apk add --no-cache git
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Embed the freshly built UI (pkg/server/web uses //go:embed all:static).
COPY --from=frontend /app/frontend/dist ./pkg/server/web/static
ARG VERSION=1.0.0
RUN go build -ldflags="-X main.Version=${VERSION}" -o /out/seedstream ./cmd/seedstream/

# --- Stage 3: runtime ---
FROM alpine:latest
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=backend /out/seedstream .
# 7000: addon UI + Stremio/AIOStreams.
EXPOSE 7000
CMD ["./seedstream"]
