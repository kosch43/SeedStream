# ================= SeedStream (single VPS) =================

PORT=7700

# Public HTTPS URL where Stremio/AIOStreams reaches this addon (no trailing slash).
# Put it behind a reverse proxy with TLS.
ADDON_BASE_URL=https://stream.yourdomain.com

# Optional secret gating the WHOLE addon. If set, the install URL becomes
# https://stream.yourdomain.com/<secret>/manifest.json and every route needs it.
# Recommended, since your box is reachable on the internet.
ADDON_SECRET=

# ---- Prowlarr ----
# Full stack: use http://prowlarr:9696   |  Existing setup: your Prowlarr URL
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=your_prowlarr_api_key
PROWLARR_INDEXER_IDS=

# ---- TMDB (optional) ----
# Improves matching for foreign/localized releases by searching and matching on
# alternative titles (e.g. a film released under its original-language name).
# Leave blank to use Cinemeta only — everything still works without it.
# Free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ---- TVDB (optional) — anime + TV matching ----
# Maps a series' season/episode to its absolute episode number (what anime
# release groups use), so anime episodes can be verified instead of guessed.
# Also adds series title aliases. Free key: https://thetvdb.com/api-information
TVDB_API_KEY=
# Only needed for user-supported (subscriber) keys; leave blank otherwise.
TVDB_PIN=

# ---- AniList (optional) — anime titles ----
# Adds anime title synonyms (romaji/native/English) for better anime matching.
# AniList reads work without a key; setting one enables this enrichment and
# raises rate limits. Token: https://anilist.co/settings/developer
ANILIST_API_KEY=

# ---- qBittorrent ----
# Full stack: use http://qbittorrent:8080  |  Existing setup: your qBit URL
QBIT_URL=http://qbittorrent:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=your_qbit_pass
QBIT_CATEGORY=seedstream
# Where qBit saves this addon's torrents. MUST be an absolute path. SeedStream
# reads files from here to serve them, so the standalone compose mounts this same
# path read-only into the container (same path on both sides).
QBIT_SAVE_PATH=/downloads/seedstream

# ---- File server ----
# LEAVE BLANK to use SeedStream's built-in file server (recommended on one VPS).
# Only set this if you want an external nginx in front (e.g. seedbox topology).
FILE_SERVER_BASE_URL=

# ---- Tuning ----
BUFFER_MB=32
BUFFER_TIMEOUT_SEC=90
MAX_RESULTS=30
SEARCH_CACHE_TTL_SEC=600
MAX_CONCURRENT_PER_BOX=3

# ---- Disk cache / retention ----
# Downloaded torrents stay seeding so replays are instant. These bound that cache
# (like rclone's vfs-cache-max-size/age), evicting the LEAST-RECENTLY-PLAYED first.
# Ratio-safe: a torrent is never evicted until it has met MIN_SEED_HOURS of seed
# time, so eviction can't cause a hit-and-run penalty. Leave caps at 0 = unbounded.
CACHE_MAX_GB=0
CACHE_MAX_AGE_DAYS=0
# Minimum accumulated seed time (hours) before a torrent may be evicted. Set to
# your strictest tracker's requirement (e.g. MyAnonaMouse requires 72h).
MIN_SEED_HOURS=72
CACHE_SWEEP_MINUTES=15

# ---- Matching / filtering ----
# Releases are parsed (resolution, source, codec, HDR, audio, group, season/episode),
# checked against the requested title/year/episode, ranked by quality, and deduped.
# Drop releases with fewer seeders than this (0 = keep all).
MIN_SEEDERS=0
# Allowlist of resolutions to show, e.g. "2160p,1080p,720p". Empty = show all.
RESOLUTIONS=
# Float this resolution to the top, e.g. "1080p" to avoid huge 4K files. Empty = best-quality order.
PREFERRED_RESOLUTION=
# Drop cam/TS/screener rips (true/false).
EXCLUDE_CAM=true
