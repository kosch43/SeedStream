# ================= SeedStream (single VPS) =================
# Supports Torrents (qBittorrent + Prowlarr) AND Usenet/NZBs (SABnzbd + Prowlarr).
# You can run torrents-only, NZBs-only, or both at the same time.

PORT=7700

# Public HTTPS URL where Stremio/AIOStreams reaches this addon (no trailing slash).
# Put it behind a reverse proxy with TLS.
ADDON_BASE_URL=https://stream.yourdomain.com

# Optional secret gating the WHOLE addon. If set, the install URL becomes
# https://stream.yourdomain.com/<secret>/manifest.json and every route needs it.
# Recommended for a private community install.
ADDON_SECRET=

# ---- Prowlarr ----
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=your_prowlarr_api_key

# ---- Torrent indexers ----
# Prowlarr indexer IDs to use for TORRENT searches (comma-separated).
# Find these in Prowlarr → Indexers → click an indexer → the ID is in the URL.
# Leave blank to search all torrent indexers Prowlarr knows about.
PROWLARR_INDEXER_IDS=

# ---- Usenet (NZB) indexers ----
# Prowlarr indexer IDs for USENET (NZB) searches (comma-separated).
# These are your Newznab indexers (NZBGeek, DogNZB, NZBFinder, etc.) in Prowlarr.
# Leave blank to disable NZB search (Usenet results won't appear in Stremio).
NZB_INDEXER_IDS=

# ---- TMDB (optional) ----
# Improves matching for foreign/localized releases via alternative titles.
# Free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ---- TVDB (optional) — anime + TV matching ----
# Absolute-episode mapping for anime + series title aliases.
# Free key: https://thetvdb.com/api-information
TVDB_API_KEY=
TVDB_PIN=

# ---- AniList (optional) — anime titles ----
# Anime title synonyms (romaji/native). Works without a key; token raises rate limits.
# Token: https://anilist.co/settings/developer
ANILIST_API_KEY=

# ===========================================================
#  TORRENT backend — qBittorrent
# ===========================================================
# Full stack: use http://qbittorrent:8080  |  Existing setup: your qBit URL
# Leave QBIT_URL blank to run in NZB-only mode.
QBIT_URL=http://qbittorrent:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=your_qbit_pass
QBIT_CATEGORY=seedstream
# Where qBit saves this addon's torrents. MUST be an absolute path.
# SeedStream serves files from here (same path inside the container).
QBIT_SAVE_PATH=/downloads/seedstream

# External nginx exposing QBIT_SAVE_PATH with range support.
# Leave blank to use SeedStream's built-in file server (recommended).
FILE_SERVER_BASE_URL=

# ===========================================================
#  USENET backend — SABnzbd
# ===========================================================
# Full stack: use http://sabnzbd:8080  |  Existing setup: your SABnzbd URL
# Leave SABNZBD_URL blank to run in torrent-only mode.
SABNZBD_URL=http://sabnzbd:8080
SABNZBD_API_KEY=your_sabnzbd_api_key
SABNZBD_CATEGORY=seedstream
# Where SABnzbd writes completed downloads. MUST be an absolute path visible
# inside this container. Map this path read-only in your compose volume.
SABNZBD_COMPLETE_PATH=/downloads/sabnzbd/complete/seedstream

# How long (seconds) to wait for SABnzbd to finish a download before returning 504.
# Usenet is fast — a 10 GB file at 100 MB/s takes ~100s. Default: 600 (10 min).
NZB_TIMEOUT_SEC=600

# ===========================================================
#  Tuning
# ===========================================================
BUFFER_MB=32
BUFFER_TIMEOUT_SEC=90
MAX_RESULTS=30
SEARCH_CACHE_TTL_SEC=600
MAX_CONCURRENT_PER_BOX=3

# ---- Disk cache / retention (torrents) ----
CACHE_MAX_GB=0
CACHE_MAX_AGE_DAYS=0
MIN_SEED_HOURS=72
CACHE_SWEEP_MINUTES=15

# ---- Matching / filtering ----
MIN_SEEDERS=0
# Allowlist of resolutions, e.g. "2160p,1080p,720p". Empty = show all.
RESOLUTIONS=
# Float this resolution to the top, e.g. "1080p". Empty = best-quality order.
PREFERRED_RESOLUTION=
# Drop cam/TS/screener rips (true/false).
EXCLUDE_CAM=true
